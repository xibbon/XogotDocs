@Tutorial(time: 10) {
    @Intro(title: "Signing Setup") {
        Connect your Apple Developer account so Xogot can sign builds for Mac, iPhone and iPad, and publish them to App Store Connect.

        @Image(source: signing-setup-menu.png)
    }

    @Section(title: "Open Signing Setup") {
        @ContentAndMedia {
            Xogot uses signing information when you run a project on a physical iPhone or iPad,
            and when you publish to App Store Connect. Do this setup one time on each Mac.
        }

        @Steps {
            @Step {
                Open your project in Xogot for Mac, then open the run destination menu in the toolbar.
                Choose **Signing Setup**.

                If signing is not configured, the menu item shows a warning sign.

                @Image(source: signing-setup-menu.png)
            }

            @Step {
                In the **Apple Developer Account** section, select how to connect your account.

                With a paid Apple Developer Program membership, use **Set it up for me** or **Set up
                manually**. Both create an App Store Connect API key. Without a paid membership, select
                **No paid membership? Sign in with your Apple ID instead**.

                @Image(source: signing-setup-methods.png)
            }
        }
    }

    @Section(title: "Let Xogot Create the API Key") {
        @ContentAndMedia {
            Xogot can create the App Store Connect API key for you. You sign in on Apple's website,
            and Xogot keeps only the API key.
        }

        @Steps {
            @Step {
                Select **Set it up for me**. Read the message, then click **Continue**.

                Xogot opens Apple's website in a private browser session. Xogot discards the session
                after it creates the key.

                @Image(source: signing-setup-automatic-confirm.png)
            }

            @Step {
                Sign in to App Store Connect with your Apple Developer account.

                You type your password directly on Apple's website. Your account must have the Admin
                role to create a team API key.

                @Image(source: signing-setup-automatic-signin.png)
            }

            @Step {
                Wait while Xogot creates the API key. When it is done, the **Status** section shows
                **App Store Connect API key configured**.

                If Xogot cannot get all the values, it shows the manual steps. Complete the steps that
                are not done.
            }
        }
    }

    @Section(title: "Create the API Key Manually") {
        @ContentAndMedia {
            You can also create the key yourself in App Store Connect. Select **Set up manually** to
            show the four steps in Signing Setup.
        }

        @Steps {
            @Step {
                Select **Set up manually**, then click **Open App Store Connect**.

                @Image(source: signing-setup-manual-steps.png)
            }

            @Step {
                Sign in to [App Store Connect](https://appstoreconnect.apple.com), then open
                **Users and Access**.

                @Image(source: app-store-connect-home.png)
            }

            @Step {
                Open **Integrations**, select **App Store Connect API**, then select **Team Keys**.

                The **Issuer ID** shows at the top of this page. You paste it into Xogot later.

                @Image(source: app-store-connect-integrations.png)
            }

            @Step {
                Click the **+** button to generate an API key. Name it `Xogot`, for **Access** choose
                **Admin**, then click **Generate**. Click **Download** for the new key.

                App Store Connect lets you download the private key one time only. Keep the
                `AuthKey_<KeyID>.p8` file in a safe location.

                @Image(source: app-store-connect-generate-api-key.png)
            }

            @Step {
                In Xogot, click **Import Key…** and select the `.p8` file, or copy the key text and
                click **Paste**. Then click **Copy** next to **Issuer ID** in App Store Connect, paste
                it into the **Issuer ID** field, and click **Save**.

                Xogot reads the Key ID from the file name. If the file name does not contain the Key
                ID, type it from the key row in App Store Connect. Xogot keeps the private key in the
                macOS Keychain.

                @Image(source: signing-setup-manual-import.png)
            }
        }
    }

    @Section(title: "Sign in with Apple ID") {
        @ContentAndMedia {
            Without a paid membership, sign in with your Apple ID. A free Apple ID gets a personal
            team: apps run only on your own devices, certificates expire after 7 days, and you cannot
            publish to the App Store.
        }

        @Steps {
            @Step {
                Select **No paid membership? Sign in with your Apple ID instead**. Enter your Apple ID
                and password, then click **Sign In**.

                To go back to the API key, select **Use an App Store Connect API key instead**.

                @Image(source: signing-setup-password.png)
            }

            @Step {
                If Apple asks you to allow the sign-in on a trusted device, click **Allow** on
                that device.

                @Image(source: signing-setup-apple-allow.png)
            }

            @Step {
                Enter the verification code from your trusted device or SMS, and click **Continue**.

                Apple sends one code for each sign-in. If you cancel this sheet, the sign-in stops.

                @Image(source: signing-setup-verification-code.png)
            }

            @Step {
                After sign-in completes, confirm that the dialog shows **Signed in with Apple
                Developer account**. Click **Done**.

                You can return to **Signing Setup** later to change teams or to log out.

                @Image(source: signing-setup-signed-in.png)
            }
        }
    }
}
