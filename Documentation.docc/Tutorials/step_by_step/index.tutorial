@Tutorial{name: "Step by Step"
    @Intro(title: "Step by Step") {
        Get started with the Xogot editor and engine by learning about nodes, scenes,
        GDScript, player input, and signals.

        These lessons establish the foundations you will use to create your first 2D
        game and explore more of Xogot.
        
        @Image(source: "fix-me.png")
    }
    @Chapter {name: "Instancing"
        @TutorialReference(tutorial: nodes_and_scenes)
    }
}
