@Tutorials(name: "Xogot for Mac Tutorials") {
    @Intro(title: "Xogot for Mac") {
        Learn how to use Xogot for Mac's unique features for builds, testing and shipping
        Godot projects targeting Apple platforms.

        These tutorials cover Apple Developer signing, Mac playtesting, runtime setup,
        and deploying games to iPhone and iPad simulators or physical devices from
        Xogot for Mac.

        @Image(source: iPhoneMacSimulator.png)
    }

    @Chapter(name: "First Tour") {
        @Image(source: mac-tour-editor-overview.png)

        Get oriented in the native Mac editor, including the workspace, Command Palette,
        code navigation, debugging tools, settings, and run destination menu.

        @TutorialReference(tutorial: "doc:00.xogot_for_mac_tour")
    }

    @Chapter(name: "Signing and Deployment") {
        @Image(source: iPhoneMacSimulator.png)

        Configure Apple Developer signing, install the required runtimes, and run
        your game on your Mac, iPhone and iPad simulators, or physical devices from
        Xogot for Mac.

        @TutorialReference(tutorial: "doc:01.signing_setup")
        @TutorialReference(tutorial: "doc:04.testing_on_mac")
        @TutorialReference(tutorial: "doc:02.simulator_deployment")
        @TutorialReference(tutorial: "doc:03.deploying_to_ios_and_ipados")
    }
}
