@Tutorial(time: 15) {
    @Intro(title: "Convert, Combine, and Export Meshes") {
        > This page is a continuation of <doc:06.modeler_collision>. Please open your
        > `courtyard.tscn` scene.

        Modeler can also edit meshes that it did not create. In this tutorial, you
        convert a primitive mesh and a CSG shape, you cut a round window with a
        Boolean operation, and you prepare the courtyard for your game.

        @Image(source: "modeler-07-intro-final.webp",
               alt: "The finished courtyard with a boulder, a round window, and exported files")
    }

    @Section(title: "Make a Boulder Editable") {
        @ContentAndMedia {
            Make Editable copies an existing mesh into a new editable mesh. The source
            does not change.

            @Image(source: "modeler-07-boulder.webp",
                   alt: "A boulder made from an edited SphereMesh")
        }

        @Steps {
            @Step {
                Add a `MeshInstance3D` to the courtyard. In the inspector, set its
                **Mesh** to a new `SphereMesh`.

                @Image(source: "modeler-07-sphere-mesh.webp",
                       alt: "A MeshInstance3D with a SphereMesh")
            }

            @Step {
                Set **Radial Segments** to 12 and **Rings** to 6.

                A lower count gives a lighter mesh that is easier to edit.

                @Image(source: "modeler-07-sphere-segments.webp",
                       alt: "SphereMesh with Radial Segments 12 and Rings 6")
            }

            @Step {
                Select **Make Editable** in the Object Actions menu.

                The panel shows the vertex, edge, face, and triangle counts of the
                result. Keep **quads** and **materials** on.

                @Image(source: "modeler-07-make-editable-panel.webp",
                       alt: "The Make Editable panel with counts and import options")
            }

            @Step {
                Select **Make Editable** in the panel.

                Select **Vertex** mode, and move some vertices to make the sphere look
                like a rough boulder.

                @Image(source: "modeler-07-boulder-vertices.gif",
                       alt: "Vertices moved to shape a boulder")
            }

            The converted mesh keeps the UV layout of the source mesh, so its texture
            looks the same. In the UV Editor, its faces show as Manual UVs.
        }
    }

    @Section(title: "Bake a CSG Shape") {
        @ContentAndMedia {
            Make Editable also accepts a CSG root. It bakes a new editable mesh and
            keeps the CSG source.

            @Image(source: "modeler-07-csg-baked.webp",
                   alt: "A CSG shape and the editable mesh baked from it")
        }

        @Steps {
            @Step {
                Add a `CSGCombiner3D` with a `CSGBox3D` and a `CSGCylinder3D` child.
                Set the cylinder operation to **Subtraction**.

                @Image(source: "modeler-07-csg-tree.webp",
                       alt: "A CSGCombiner3D with a box and a subtracted cylinder")
            }

            @Step {
                Select the `CSGCombiner3D`, and select **Make Editable**.

                Xogot adds an editable mesh. You can now edit it like any other Modeler
                mesh. Hide or delete the CSG source when you do not need it.

                @Image(source: "modeler-07-csg-make-editable.webp",
                       alt: "The editable mesh created from the CSG root")
            }
        }
    }

    @Section(title: "Cut a Round Window with a Boolean") {
        @ContentAndMedia {
            Boolean operations combine two meshes. Subtraction removes the second mesh
            from the first.

            > Note: Boolean operations are experimental. To use them, turn on
            > experimental features in the Modeler preferences.

            @Image(source: "modeler-07-round-window.webp",
                   alt: "A round window cut through the front wall")
        }

        @Steps {
            @Step {
                Place a **Cylinder** through the front wall, beside the gate. Rotate it
                so that it goes through the wall.

                @Image(source: "modeler-07-cylinder-through-wall.webp",
                       alt: "A Cylinder that goes through the front wall")
            }

            @Step {
                Select the wall first, and then the cylinder. Select **Boolean** in the
                Object Actions menu, and select **Subtraction**.

                @Image(source: "modeler-07-boolean-panel.webp",
                       alt: "The Boolean panel with Subtraction selected")
            }

            @Step {
                Select **Apply**.

                Xogot creates a new editable mesh next to the wall. Both source objects
                stay. Hide or delete them to see the result.

                @Image(source: "modeler-07-boolean-result.webp",
                       alt: "The Boolean result with the source objects hidden")
            }
        }
    }

    @Section(title: "Export a Mesh") {
        @ContentAndMedia {
            Export a mesh to use it in another application or project.

            @Image(source: "modeler-07-export-dialog.webp",
                   alt: "The export dialog with the OBJ format selected")
        }

        @Steps {
            @Step {
                Select the fountain meshes. Select **Export Mesh** in the Object Actions
                menu.

                @Image(source: "modeler-07-export-command.webp",
                       alt: "The Export Mesh command in the Object Actions menu")
            }

            @Step {
                Select **OBJ**. Turn on **Apply World Transforms**, **Combine Objects**,
                and the option to copy textures. Choose a destination file.

                Xogot writes an OBJ file, an MTL file, and PNG textures.

                @Image(source: "modeler-07-export-obj-options.webp",
                       alt: "The OBJ export options")
            }

            @Step {
                To use a mesh in another Godot scene, export it as **Native Mesh** or
                **glTF**.

                If a file already exists, Xogot asks before it replaces the file.

                <!-- @Image(source: "modeler-07-export-overwrite.png",
                       alt: "The confirmation to replace existing export files") -->
            }
        }
    }

    @Section(title: "Prepare the Courtyard for Your Game") {
        @ContentAndMedia {
            The editable data is necessary only in the editor. You can remove it when
            the level is final.

            @Image(source: "modeler-07-stripped.webp",
                   alt: "The inspector of a mesh after its editable data was removed")
        }

        @Steps {
            @Step {
                Select a mesh that is final. In the Editable Mesh inspector, select
                **Strip Editable Mesh Data**.

                The mesh, its materials, and its collision nodes stay. Use Undo to
                restore the editable data.

                > Warning: After you strip a mesh and close the scene, you cannot edit
                > the mesh with Modeler again. Keep a copy of the scene if you plan more
                > changes.

                @Image(source: "modeler-07-strip-command.webp",
                       alt: "The Strip Editable Mesh Data command in the inspector")
            }

            @Step {
                Save the scene.

                All of the courtyard meshes are ordinary Godot `MeshInstance3D` nodes.
                The scene also opens in stock Godot.

                @Image(source: "modeler-07-final-courtyard.webp",
                       alt: "The finished courtyard level")
            }

            Congratulations, you built a complete level with Xogot Modeler. For all of
            the tools, actions, and shortcuts, see <doc:Xogot-Modeler>.
        }
    }
}
